import types
from _typeshed import Incomplete

__all__ = ['AudioOut', 'sample_out']

class _Rearranging:
    def __enter__(self) -> None: ...
    def __exit__(self, exc_type: type[BaseException] | None, exc: BaseException | None, tb: types.TracebackType | None): ...

class AudioOut:
    transport: Incomplete
    chunk_ms: Incomplete
    stalls: int
    def __init__(self, transport, *, chunk_ms: int = 40, lookahead_chunks: int = 2, max_catchup_chunks: int = 5, pump: bool = True) -> None: ...
    @property
    def format(self): ...
    def open(self): ...
    def close(self) -> None: ...
    deinit = close
    def __enter__(self): ...
    def __exit__(self, exc_type: type[BaseException] | None, exc: BaseException | None, tb: types.TracebackType | None) -> None: ...
    @property
    def pumped(self): ...
    @property
    def pump_refused(self): ...
    @property
    def volume(self): ...
    def set_volume(self, percent): ...
    @property
    def muted(self): ...
    def mute(self, value: bool = True): ...
    @property
    def codec(self): ...
    def play(self, sample, *, loop: bool = False) -> None: ...
    def stop(self) -> None: ...
    def pause(self) -> None: ...
    def resume(self) -> None: ...
    @property
    def playing(self): ...
    @property
    def paused(self): ...
    def service(self) -> None: ...
    def attach(self, app, period_ms=None): ...
    def detach(self) -> None: ...

def sample_out(transport_factory, format=None, **kwargs): ...
