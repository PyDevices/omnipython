class Gamepad:
    def __init__(self, devices) -> None: ...
    def press_buttons(self, *buttons) -> None: ...
    def release_buttons(self, *buttons) -> None: ...
    def release_all_buttons(self) -> None: ...
    def click_buttons(self, *buttons) -> None: ...
    def move_joysticks(self, x=None, y=None, z=None, r_z=None) -> None: ...
    def set_hat(self, direction) -> None: ...
    def set(self, buttons=None, hat=..., x=None, y=None, z=None, r_z=None) -> None: ...
    def reset_all(self) -> None: ...
