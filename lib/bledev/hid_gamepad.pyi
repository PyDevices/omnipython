"""A gamepad for a `bledev.hid.Peripheral`, in the shape of Adafruit's `hid_gamepad.py` example."""
from collections.abc import Iterable
from typing import Any, Protocol

class _HIDDevice(Protocol):
    usage_page: int
    usage: int
    def send_report(self, report: bytearray, /) -> Any: ...

class Gamepad:
    """Emulate a gamepad with sixteen buttons, a hat and four joystick axes."""

    def __init__(self, devices: _HIDDevice | Iterable[_HIDDevice]) -> None: ...
    def press_buttons(self, *buttons: int) -> None: ...
    def release_buttons(self, *buttons: int) -> None: ...
    def release_all_buttons(self) -> None: ...
    def click_buttons(self, *buttons: int) -> None: ...
    def move_joysticks(self, x: int | None = None, y: int | None = None, z: int | None = None, r_z: int | None = None) -> None: ...
    def set_hat(self, direction: int | None) -> None: ...
    def set(self, buttons: int | None = None, hat: int | None = ..., x: int | None = None, y: int | None = None, z: int | None = None, r_z: int | None = None) -> None: ...
    def reset_all(self) -> None: ...
