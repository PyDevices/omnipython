"""SDL-style key codes, names, and modifier masks."""


def keyname(x: int) -> str:
    """Return the human-readable name for key code `x`, or ``"Unknown"``."""
def key(x: str) -> int:
    """Return the key code whose name is `x`; raises `ValueError` for an unknown name."""
def modname(x: int) -> str:
    """Return the human-readable name for modifier mask `x`, or ``"Unknown"``."""
def mod(x: str) -> int:
    """Return the modifier mask whose name is `x`; raises `ValueError` for an unknown name."""

