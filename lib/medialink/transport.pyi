import types
from _typeshed import Incomplete
from medialink._compat import sleep_ms as sleep_ms, socket_pool as socket_pool

class Transport:
    mtu: int
    bandwidth: int
    def open(self): ...
    def close(self) -> None: ...
    def send(self, data, address) -> None: ...
    def recv_into(self, buf) -> None: ...
    def __enter__(self): ...
    def __exit__(self, *exc) -> None: ...

class UDPTransport(Transport):
    mtu: int
    bandwidth: int
    port: Incomplete
    def __init__(self, port: int = 0, *, interface=None, power_save: bool = False) -> None: ...
    def open(self): ...
    def close(self) -> None: ...
    def send(self, data, address) -> None: ...
    def recv_into(self, buf): ...
