from _typeshed import Incomplete
from medialink._compat import ticks_diff as ticks_diff, ticks_ms as ticks_ms

JPEG: int

class Video:
    link: Incomplete
    burst: Incomplete
    stats: Incomplete
    def __init__(self, link, *, bandwidth=None, burst: int = 4) -> None: ...
    @property
    def ready(self): ...
    def send(self, jpeg, stamp=None, codec=...): ...
    def service(self) -> None: ...
    def receive(self): ...

class Screen:
    display: Incomplete
    background: Incomplete
    rect: Incomplete
    errors: int
    last_error: Incomplete
    def __init__(self, display, background: int = 0, rect=None) -> None: ...
    def show(self, jpeg): ...

class FileCamera:
    paths: Incomplete
    def __init__(self, folder) -> None: ...
    def take(self): ...
    def capture_jpeg(self, quality=None): ...
    def deinit(self) -> None: ...
