from collections.abc import Callable
from typing import Any, Protocol

__all__ = ['byteswap', 'capabilities', 'alloc_buffer', 'color565', 'color565_swapped', 'color332', 'color_rgb', 'DisplayDriver']

class _HasRotation(Protocol):
    rotation: int

byteswap: Callable[[bytearray | memoryview], None]

def capabilities() -> dict[str, Any]:
    """Static metadata for the modular displaydev install model (no backend imports)."""
def alloc_buffer(size: int) -> memoryview:
    """Create a new buffer of the specified size, in PSRAM when the port exposes it."""
def color565(r: int | tuple[int, ...] | list[int], g: int | None = None, b: int | None = None) -> int:
    """Convert RGB values to a 16-bit color value."""
def color565_swapped(r: int | tuple[int, ...] | list[int], g: int = 0, b: int = 0) -> int:
    """Convert RGB to 16-bit RGB565 with byte order swapped for some displays."""
def color332(r: int, g: int, b: int) -> int:
    """Convert RGB to 8-bit RGB332 color."""
def color_rgb(color: int | tuple[int, ...] | list[int] | bytes | bytearray) -> tuple[int, int, int]:
    """Expand a display color to an (r, g, b) tuple."""

class FrameClock:
    """A display's frame cadence as a subscription: `subscribe(fn)` calls `fn()` once per frame."""
    name: str
    count: int
    last: int | None
    def __init__(self, period_ms: int, name: str | None = None) -> None: ...
    @property
    def period_ms(self) -> int: ...
    @period_ms.setter
    def period_ms(self, value: int) -> None: ...
    @property
    def running(self) -> bool: ...
    def subscribe(self, fn: Callable[[], Any]) -> Callable[[], Any]: ...
    def unsubscribe(self, fn: Callable[[], Any]) -> None: ...
    def stop(self) -> None: ...

class DisplayDriver:
    """Base class for all display backends."""
    needs_refresh: bool
    can_rotate: bool
    refresh_period_ms: int
    share_framebuffer: bool
    quit_chord: tuple[int, int] | None
    @property
    def frame_clock(self) -> FrameClock: ...
    def framebuffers(self) -> tuple[bytearray | memoryview, bytearray | memoryview | None, int, int] | None: ...
    byteswap: Callable[[bytearray | memoryview], None]
    touch_scale: float
    def __init__(self, *, quiet: bool = False) -> None: ...
    def __del__(self) -> None: ...
    @property
    def width(self) -> int: ...
    @property
    def height(self) -> int: ...
    @property
    def rotation(self) -> int: ...
    @rotation.setter
    def rotation(self, value: int) -> None: ...
    @property
    def touch_device(self) -> _HasRotation | None: ...
    @touch_device.setter
    def touch_device(self, value: _HasRotation | None) -> None: ...
    def fill(self, color: int) -> Any: ...
    def scroll(self, dx: int, dy: int) -> None: ...
    def disable_auto_byteswap(self, value: bool) -> bool: ...
    @property
    def requires_byteswap(self) -> bool: ...
    def blit_transparent(self, buf: memoryview, x: int, y: int, w: int, h: int, key: int) -> tuple[int, int, int, int]: ...
    @property
    def vscroll(self) -> int: ...
    @vscroll.setter
    def vscroll(self, y: int) -> None: ...
    def set_vscroll(self, tfa: int = 0, bfa: int = 0) -> None: ...
    @property
    def tfa(self) -> int: ...
    @property
    def vsa(self) -> int: ...
    @property
    def bfa(self) -> int: ...
    def translate_point(self, point: tuple[int, int]) -> tuple[int, int]: ...
    def scroll_by(self, value: int) -> None: ...
    def scroll_to(self, value: int) -> None: ...
    @property
    def tfa_area(self) -> tuple[int, int, int, int]: ...
    @property
    def vsa_area(self) -> tuple[int, int, int, int]: ...
    @property
    def bfa_area(self) -> tuple[int, int, int, int]: ...
    def measure_fps(self, on: bool = True) -> None: ...
    def frame_done(self) -> None: ...
    def fps(self) -> dict[str, float | int] | None: ...
    def fps_reset(self) -> None: ...
    def fps_print(self, seconds: float = 5) -> None: ...
    def vscrdef(self, tfa: int, vsa: int, bfa: int) -> None: ...
    def vscsad(self, vssa: int | None = None) -> int: ...
    @property
    def power(self) -> bool: ...
    @power.setter
    def power(self, value: bool) -> None: ...
    @property
    def brightness(self) -> float: ...
    @brightness.setter
    def brightness(self, value: float) -> None: ...
    def invert_colors(self, value: bool) -> None: ...
    def reset(self) -> None: ...
    def hard_reset(self) -> None: ...
    def soft_reset(self) -> None: ...
    def sleep_mode(self, value: bool) -> None: ...
    def deinit(self) -> None: ...
    def quit(self, code: int = 0, force: bool = False) -> None: ...
    def force_quit(self, code: int = 0) -> None: ...
    def show(self, *args: Any, **kwargs: Any) -> None: ...
