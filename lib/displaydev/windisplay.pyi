from collections.abc import Callable
from typing import Any

from appdev.app import App
from displaydev import DisplayDriver

__all__ = ['maximized_size', 'poll_event', 'get_events', 'WinDisplay']

class _DesktopDisplay(DisplayDriver):
    def vscrdef(self, tfa: int, vsa: int, bfa: int) -> None: ...
    def vscsad(self, vssa: int | None = None) -> int: ...

def maximized_size() -> tuple[int, int]:
    """Return `(width, height)` a `WinDisplay(maximized=True)` would open at."""
def poll_event() -> tuple[Any, ...] | None: ...
def get_events() -> list[tuple[Any, ...]] | None: ...

class WinDisplay(_DesktopDisplay):
    """Emulate an LCD window with a Win32 HWND (via `uwin32`)."""
    needs_refresh: bool
    quit_chord: tuple[int, int]
    app: App | None
    color_depth: int
    touch_scale: float
    get_events: Callable[[], list[tuple[Any, ...]] | None]
    def __init__(self, width: int = 320, height: int = 240, rotation: int = 0, color_depth: int = 16, title: str = 'Win32 Display', scale: float = 1.0, x: int | None = None, y: int | None = None, *, quiet: bool = False, maximized: bool = False) -> None: ...
    def init(self) -> None: ...
    def blit_rect(self, buffer: memoryview | bytes | bytearray, x: int, y: int, w: int, h: int) -> tuple[int, int, int, int]: ...
    def fill_rect(self, x: int, y: int, w: int, h: int, c: int) -> tuple[int, int, int, int]: ...
    def pixel(self, x: int, y: int, c: int) -> tuple[int, int, int, int]: ...
    def render(self, renderRect: tuple[int, int, int, int] | None = None) -> None: ...
    def show(self, _timer: Any = None) -> None: ...
