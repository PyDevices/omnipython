from collections.abc import Callable
from typing import Any, Protocol

from appdev.app import App
from displaydev import DisplayDriver

class _FrameRecorder(Protocol):
    def write(self, rgb_bytes: bytes) -> Any: ...
    def close(self) -> int: ...

class _FrameRecorderMixin:
    @property
    def frame_recording(self) -> bool: ...
    def open_frame_recorder(self, path: str, *, fps: int = 12, width: int | None = None, height: int | None = None) -> _FrameRecorder: ...
    def close_frame_recorder(self) -> int: ...

class _DesktopDisplay(DisplayDriver):
    def vscrdef(self, tfa: int, vsa: int, bfa: int) -> None: ...
    def vscsad(self, vssa: int | None = None) -> int: ...

def poll_event() -> tuple[Any, ...] | None:
    """Poll for one pending event."""
def get_events() -> list[tuple[Any, ...]] | None:
    """Drain all pending events from the SDL queue."""
def retcheck(retvalue: int) -> None: ...

class SDLDisplay(_FrameRecorderMixin, _DesktopDisplay):
    """Emulate an LCD window with SDL2 (via `usdl2`)."""
    needs_refresh: bool
    quit_chord: tuple[int, int]
    color_depth: int
    touch_scale: float
    app: App | None
    get_events: Callable[[], list[tuple[Any, ...]] | None]
    def __init__(self, width: int = 320, height: int = 240, rotation: int = 0, color_depth: int = 16, title: str = 'SDL2 Display', scale: float = 1.0, window_flags: int = ..., render_flags: int = ..., x: int = ..., y: int = ..., *, quiet: bool = False) -> None: ...
    def init(self) -> None: ...
    def blit_rect(self, buffer: memoryview, x: int, y: int, w: int, h: int) -> tuple[int, int, int, int]: ...
    def fill_rect(self, x: int, y: int, w: int, h: int, c: int) -> tuple[int, int, int, int]: ...
    def pixel(self, x: int, y: int, c: int) -> tuple[int, int, int, int]: ...
    def render(self, renderRect: tuple[int, int, int, int] | None = None) -> None: ...
    def show(self, _timer: Any = None) -> None: ...
    def capture_rgb(self) -> tuple[bytes, int, int]: ...
    def quit(self, code: int = 0, force: bool = False) -> None: ...
    def force_quit(self, code: int = 0) -> None: ...
