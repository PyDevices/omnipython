"""A browser page's camera, read the way cameraif reads a board's."""

from typing import Any

import endpointkit

DEFAULT: str
OPEN_MS: int
LIST_MS: int

class Camera:
    """The page's camera, open: the one chosen in endpointkit, or the browser's choice."""

    def __init__(self, format: Any = None, flip: bool = False, mirror: bool = False, timeout: int = ..., bridge: Any = None) -> None: ...
    def size(self) -> tuple[int, int, int]: ...
    def capture_scaled(
        self,
        dst: bytearray | memoryview,
        pic_w: int,
        pic_h: int,
        *,
        x: int = 0,
        y: int = 0,
        w: int = 0,
        h: int = 0,
        rotate: int = 0,
        mirror: bool = False,
        src_rect: tuple[int, int, int, int] | None = None,
        swap: bool = False,
        timeout: int = 1000,
    ) -> tuple[int, int] | None: ...
    def capture_jpeg(self, quality: int = 80, timeout: int = 1000) -> bytes | None: ...
    def flip(self, on: bool | None = None) -> bool: ...
    def mirror(self, on: bool | None = None) -> bool: ...
    def exposure(self, pct: int | None = None, raw: bool = False) -> None: ...
    def gain(self, pct: int | None = None, raw: bool = False) -> None: ...
    def reg(self, *args: int) -> None: ...
    def close(self) -> None: ...
    def deinit(self) -> None: ...
    def __enter__(self) -> "Camera": ...
    def __exit__(self, *exc: Any) -> None: ...

class Cameras(endpointkit.Provider):
    """The page's cameras under ``camera``."""

    devices: Any
    route: Any
    has_camera: bool
    def __init__(self, devices: Any = None, route: Any = None, has_camera: bool | None = None) -> None: ...
    def listed(self) -> bool: ...
    def scan(self) -> list[endpointkit.Endpoint]: ...
    def poll(self) -> list[endpointkit.Endpoint] | None: ...
    def apply(self, endpoint: endpointkit.Endpoint, chosen: bool) -> None: ...
