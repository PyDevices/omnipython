from _typeshed import Incomplete
from displaydev._webcanvas import CanvasDisplay as CanvasDisplay
from displaydev._webinput import WebInput as WebInput

class WorkerDevices(WebInput):
    def feed(self, event) -> None: ...

class _Event:
    def __init__(self, d) -> None: ...
    def __getattr__(self, name) -> None: ...

class WorkerDisplay(CanvasDisplay):
    needs_refresh: bool
    quit_chord: Incomplete
    get_events: Incomplete
    feed: Incomplete
    def __init__(self, canvas, width=None, height=None, *, quiet: bool = False) -> None: ...
    def set_css_size(self, width, height) -> None: ...
    @property
    def touch_scale(self): ...
    @touch_scale.setter
    def touch_scale(self, value) -> None: ...
    def map_pointer(self, local_x, local_y): ...
    def map_pointer_rel(self, dx, dy): ...

def feed(event) -> None: ...
def resize(width, height) -> None: ...
