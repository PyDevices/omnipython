from collections.abc import Callable
from typing import Any

from displaydev import DisplayDriver

class _DesktopDisplay(DisplayDriver):
    def vscrdef(self, tfa: int, vsa: int, bfa: int) -> None: ...
    def vscsad(self, vssa: int | None = None) -> int: ...

class _WebInput:
    canvas: Any
    def __init__(self, display: Any = None) -> None: ...
    def read(self) -> list[tuple[Any, ...]] | None: ...

class _CanvasDisplay(_DesktopDisplay):
    needs_refresh: bool
    color_depth: int
    def __init__(self, canvas: Any, width: int | None = None, height: int | None = None, *, quiet: bool = False) -> None: ...
    def init(self) -> None: ...
    def fill_rect(self, x: int, y: int, w: int, h: int, c: int) -> tuple[int, int, int, int]: ...
    def blit_rect(self, buf: bytes | bytearray | memoryview, x: int, y: int, w: int, h: int) -> tuple[int, int, int, int]: ...
    def pixel(self, x: int, y: int, c: int) -> tuple[int, int, int, int]: ...
    def render(self, render_rect: tuple[int, int, int, int] | None = None) -> None: ...
    def show(self, _timer: Any = None) -> None: ...

class WorkerDevices(_WebInput):
    """Input for a `WorkerDisplay`, fed by events the page relays."""
    def feed(self, event: Any) -> None: ...

class WorkerDisplay(_CanvasDisplay):
    """Emulate a display on an `OffscreenCanvas`, from a Web Worker."""
    needs_refresh: bool
    quit_chord: tuple[int, int]
    get_events: Callable[[], list[tuple[Any, ...]] | None]
    feed: Callable[[Any], None]
    def __init__(self, canvas: Any, width: int | None = None, height: int | None = None, *, quiet: bool = False) -> None: ...
    def set_css_size(self, width: float, height: float) -> None: ...
    @property
    def touch_scale(self) -> float: ...
    @touch_scale.setter
    def touch_scale(self, value: float) -> None: ...
    def map_pointer(self, local_x: float, local_y: float) -> tuple[int, int]: ...
    def map_pointer_rel(self, dx: float, dy: float) -> tuple[int, int]: ...

def feed(event: Any) -> None:
    """Hand a relayed `input` event to the most recent `WorkerDisplay`."""
def resize(width: float, height: float) -> None:
    """Hand a relayed `resize` to the most recent `WorkerDisplay`."""
