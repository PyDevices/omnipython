from collections.abc import Callable, Sequence
from typing import Any, Protocol

from displaydev import DisplayDriver as DisplayDriver

class _Bus(Protocol):
    def send(self, command: int, data: Any = ...) -> Any: ...

class BusDisplay(DisplayDriver):
    """Base class for displays connected via a bus."""
    display_bus: _Bus
    color_depth: int
    bgr: bool
    send: Callable[..., Any]
    send_color: Callable[..., Any]
    rotation_table: tuple[int, int, int, int]
    def __init__(self, display_bus: _Bus, init_sequence: bytes | bytearray | memoryview | Sequence[tuple[int, bytes | bytearray | memoryview, int]] | None = None, *, width: int = 0, height: int = 0, colstart: int = 0, rowstart: int = 0, rotation: int = 0, mirrored: bool = False, color_depth: int = 16, bgr: bool = False, invert: bool = False, reverse_bytes_in_word: bool = False, brightness: float = 1.0, backlight_pin: Any = None, backlight_on_high: bool = True, reset_pin: Any = None, reset_high: bool = True, power_pin: Any = None, power_on_high: bool = True, set_column_command: int = 42, set_row_command: int = 43, write_ram_command: int = 44, brightness_command: int | None = None, data_as_commands: bool = False, single_byte_bounds: bool = False, quiet: bool = False) -> None: ...
    def init(self) -> None: ...
    def blit_rect(self, buf: memoryview, x: int, y: int, w: int, h: int) -> tuple[int, int, int, int]: ...
    def fill_rect(self, x: int, y: int, w: int, h: int, c: int) -> tuple[int, int, int, int]: ...
    def pixel(self, x: int, y: int, c: int) -> tuple[int, int, int, int]: ...
    def vscrdef(self, tfa: int, vsa: int, bfa: int) -> None: ...
    def vscsad(self, vssa: int | None = None) -> int: ...
    @property
    def colstart(self) -> int: ...
    @property
    def rowstart(self) -> int: ...
    @property
    def power(self) -> bool: ...
    @power.setter
    def power(self, value: bool) -> None: ...
    @property
    def brightness(self) -> float: ...
    @brightness.setter
    def brightness(self, value: float) -> None: ...
    def invert_colors(self, value: bool) -> None: ...
    def reset(self) -> None: ...
    def hard_reset(self) -> None: ...
    def soft_reset(self) -> None: ...
    def sleep_mode(self, value: bool) -> None: ...
