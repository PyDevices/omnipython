from typing import Any, NoReturn, Protocol

from displaydev import DisplayDriver as DisplayDriver, color_rgb as color_rgb

HORIZONTAL: int
VERTICAL: int

class _Pixels(Protocol):
    def __setitem__(self, index: int, value: tuple[int, int, int]) -> None: ...
    def show(self) -> None: ...

class _PixelBuffer(Protocol):
    @property
    def width(self) -> int: ...
    @property
    def height(self) -> int: ...
    def fill_rect(self, x: int, y: int, w: int, h: int, c: int) -> Any: ...
    def pixel(self, x: int, y: int, c: int | None = ...) -> Any: ...
    def display(self) -> None: ...

class PixelFramebuffer:
    """NeoPixel / DotStar grid framebuffer for MicroPython."""
    rotation: int
    def __init__(self, pixels: _Pixels, width: int, height: int, orientation: int = ..., alternating: bool = True, reverse_x: bool = False, reverse_y: bool = False, top: tuple[int, int] | int = 0, bottom: tuple[int, int] | int = 0, rotation: int = 0) -> None: ...
    @property
    def width(self) -> int: ...
    @property
    def height(self) -> int: ...
    @property
    def stride(self) -> int: ...
    def fill_rect(self, x: int, y: int, w: int, h: int, c: int) -> tuple[int, int, int, int]: ...
    def pixel(self, x: int, y: int, c: int | None = None) -> int | None: ...
    def blit(self) -> NoReturn: ...
    def display(self) -> None: ...

class PixelDisplay(DisplayDriver):
    """DisplayDriver for addressable-LED matrix layouts."""
    can_rotate: bool
    color_depth: int
    def __init__(self, pixel_buffer: _PixelBuffer, *, quiet: bool = False) -> None: ...
    def init(self) -> None: ...
    def fill_rect(self, x: int, y: int, w: int, h: int, c: int) -> Any: ...
    def blit_rect(self, buf: bytes | bytearray | memoryview, x: int, y: int, w: int, h: int) -> tuple[int, int, int, int]: ...
    def pixel(self, x: int, y: int, c: int) -> Any: ...
    def show(self, _timer: Any = None) -> None: ...
