from typing import Any

from displaydev import DisplayDriver as DisplayDriver

class FBDisplay(DisplayDriver):
    """A display over a CircuitPython or MicroPython FrameBuffer object."""
    can_rotate: bool
    @property
    def share_framebuffer(self) -> bool: ...  # type: ignore[override]
    @property
    def needs_refresh(self) -> bool: ...  # type: ignore[override]
    color_depth: int
    def __init__(self, buffer: Any, width: int | None = None, height: int | None = None, reverse_bytes_in_word: bool = False, *, bitmap: Any = None, display: Any = None, quiet: bool = False) -> None: ...
    def framebuffers(self) -> tuple[bytearray | memoryview, bytearray | memoryview | None, int, int]: ...
    def init(self) -> None: ...
    def fill_rect(self, x: int, y: int, w: int, h: int, c: int) -> tuple[int, int, int, int]: ...
    def blit_rect(self, buf: bytes | bytearray | memoryview, x: int, y: int, w: int, h: int) -> tuple[int, int, int, int]: ...
    def pixel(self, x: int, y: int, c: int) -> tuple[int, int, int, int]: ...
    def show(self, _timer: Any = None) -> None: ...
    def show_nowait(self) -> bool: ...
    def wait_shown(self) -> None: ...
    def flush_rect(self, x: int, y: int, w: int, h: int) -> bool: ...
