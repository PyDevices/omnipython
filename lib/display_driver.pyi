class InputDevice:
    type: int
    responses: Incomplete
    def __init__(self, read=None, data=None, read2=None, data2=None) -> None: ...
    @property
    def app(self): ...
    @app.setter
    def app(self, value) -> None: ...
    @property
    def user_data(self): ...
    @user_data.setter
    def user_data(self, value) -> None: ...
    def subscribe(self, callback, event_types=None) -> None: ...
    def unsubscribe(self, callback, event_types=None) -> None: ...
    def poll(self, *args): ...

class HostInput(InputDevice):
    type = HOST
    scale: Incomplete
    def __init__(self, host_read, display=None, event_filter=None) -> None: ...

class TouchInput(InputDevice):
    type = POINTER
    responses: Incomplete
    points: Incomplete
    def __init__(self, read, display, rotation_table=None) -> None: ...
    @property
    def rotation(self): ...
    @rotation.setter
    def rotation(self, value) -> None: ...

class KeypadInput(InputDevice):
    type = KEYPAD
    responses: Incomplete
    def __init__(self, read) -> None: ...

class EncoderInput(InputDevice):
    type = ENCODER
    responses: Incomplete
    def __init__(self, read, button_read=None, button: int = 2) -> None: ...

class VirtualDevices:
    class VirtualDevice:
        type: Incomplete
        user_data: Incomplete
        points: Incomplete
        def __init__(self, owner, device_type) -> None: ...
        def subscribe(self, callback, event_types=None) -> None: ...
        def unsubscribe(self, callback, event_types=None) -> None: ...
        @property
        def has_pending(self): ...
        def poll(self, *args) -> None: ...
        def add_event(self, event) -> None: ...
    devices: Incomplete
    def __init__(self, host_device, window_id=None) -> None: ...
    def poll_host_device(self) -> None: ...

class event_loop:
    max_yield_ms: int
    delay: Incomplete
    refresh_cb: Incomplete
    exception_sink: Incomplete
    passes: int
    slow_passes: int
    last_pass_ms: int
    def __init__(self, freq=None, max_scheduled: int = 2, refresh_cb=None, asynchronous: bool = False, exception_sink=None, period_ms=None, max_yield_ms=None) -> None: ...
    @property
    def timer(self): ...
    def deinit(self) -> None: ...
    def disable(self) -> None: ...
    def enable(self) -> None: ...
    @staticmethod
    def is_running(): ...
    @staticmethod
    def current_instance(): ...
    def task_handler(self, _=None): ...
    def tick(self) -> None: ...
    def default_exception_sink(self, e) -> None: ...

