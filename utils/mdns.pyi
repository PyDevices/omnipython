"""CircuitPython's `mdns` API on CPython, over python-zeroconf."""

from collections.abc import Iterable
from ipaddress import IPv4Address
from typing import Never

__all__ = ["RemoteService", "Server"]

class RemoteService:
    """A service that answered `Server.find`. Read-only."""

    def __init__(self, *args: object, **kwargs: object) -> Never: ...
    @property
    def hostname(self) -> str: ...
    @property
    def instance_name(self) -> str: ...
    @property
    def service_type(self) -> str: ...
    @property
    def protocol(self) -> str: ...
    @property
    def port(self) -> int: ...
    @property
    def ipv4_address(self) -> IPv4Address | None: ...

class Server:
    """Answers for this computer's services and finds other devices'."""

    def __init__(self, network_interface: str | None) -> None: ...
    @property
    def hostname(self) -> str: ...
    @hostname.setter
    def hostname(self, name: str) -> None: ...
    @property
    def instance_name(self) -> str: ...
    @instance_name.setter
    def instance_name(self, name: str) -> None: ...
    def find(self, *, service_type: str, protocol: str, timeout: float = 1) -> tuple[RemoteService, ...]: ...
    def advertise_service(
        self,
        *,
        service_type: str,
        protocol: str,
        port: int,
        txt_records: Iterable[str | bytes] | None = None,
    ) -> None: ...
    def deinit(self) -> None: ...
    def __del__(self) -> None: ...
