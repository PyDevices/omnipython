"""Display framebuffer, rendering, and app integration."""

from typing import Any, Protocol

from . import Area, ColorTheme
from .task import Task
from .widget import Widget, _Event

class _DisplayDriver(Protocol):
    """The hardware driver a `Display` draws through."""

    width: int
    height: int
    color_depth: int
    requires_byteswap: bool
    def set_vscroll(self, tfa: int, bfa: int) -> Any: ...
    def disable_auto_byteswap(self, disable: bool) -> bool: ...
    def blit_rect(self, buf: Any, x: int, y: int, w: int, h: int) -> Any: ...
    def fill_rect(self, x: int, y: int, w: int, h: int, color: int) -> Any: ...
    def show(self) -> Any: ...
    def __getattr__(self, name: str) -> Any: ...

class _Canvas(Protocol):
    """Drawing surface (a framebuffer or a clipped view of one)."""

    def fill_rect(self, x: int, y: int, w: int, h: int, color: int) -> Area: ...
    def __getattr__(self, name: str) -> Any: ...

class FocusManager:
    """Tracks focusable widgets and moves keyboard focus without a pointer."""

    @property
    def focused(self) -> Widget | None: ...
    def register(self, widget: Widget) -> None: ...
    def unregister(self, widget: Widget) -> None: ...
    def focus(self, widget: Widget | None) -> None: ...
    def blur(self) -> None: ...
    def focus_next(self, reverse: bool = False) -> None: ...
    def handle_key(self, event: _Event) -> bool: ...

class Display(Widget):
    """Root display surface that owns the framebuffer, event loop, and widget tree."""

    displays: list[Display]
    timer: None
    tick_period: int
    display_drv: _DisplayDriver
    app: Any
    framebuf: _Canvas
    focus_manager: FocusManager
    needs_swap: bool
    pal: Any
    def __init__(self, display_drv: _DisplayDriver, app: Any, tfa: int = 0, bfa: int = 0, format: int = ...) -> None: ...
    @property  # type: ignore[override, misc]
    def parent(self) -> None: ...
    @parent.setter
    def parent(self, parent: None) -> None: ...
    @property  # type: ignore[override, misc]
    def x(self) -> int: ...
    @property  # type: ignore[override, misc]
    def y(self) -> int: ...
    @property  # type: ignore[override, misc]
    def width(self) -> int: ...
    @property  # type: ignore[override, misc]
    def height(self) -> int: ...
    @property
    def display(self) -> Display: ...
    @property
    def color_theme(self) -> ColorTheme: ...
    @property
    def visible(self) -> bool: ...
    @visible.setter
    def visible(self, visible: bool) -> None: ...
    def clip_push(self, area: Area) -> None: ...
    def clip_pop(self) -> None: ...
    def handle_event(self, event: _Event, condition: Any = None, point: Any = None) -> None: ...
    @property
    def active_screen(self) -> Widget | None: ...
    @active_screen.setter
    def active_screen(self, screen: Widget) -> None: ...
    def add_child(self, screen: Widget) -> None: ...
    def set_position(self, *args: Any, **kwargs: Any) -> None: ...
    def add_task(self, callback: Any, delay: int) -> Task: ...
    def refresh(self, area: Area) -> None: ...
    def remove_task(self, task: Task) -> None: ...
    def quit(self) -> None: ...
    def deinit(self) -> None: ...
    def tick(self) -> None: ...
    def render_dirty_widgets(self) -> None: ...
    def __getattr__(self, name: str) -> Any: ...
    def __setattr__(self, name: str, value: Any) -> None: ...

def tick(_: Any = None) -> None: ...
