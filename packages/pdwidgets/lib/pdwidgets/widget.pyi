"""Base widget class and geometry/event primitives."""

from collections.abc import Callable
from typing import Any, TypeAlias

import events

from . import ALIGN as ALIGN, DEFAULT_PADDING as DEFAULT_PADDING, POSITION as POSITION, Area, ColorTheme as ColorTheme
from .display import Display
from .pct import _Length

_Event: TypeAlias = (
    events.Unknown
    | events.Motion
    | events.Button
    | events.Wheel
    | events.Key
    | events.Quit
    | events.Any
    | events.JoyAxisMotion
    | events.JoyButtonUp
    | events.JoyButtonDown
    | events.JoyHatMotion
    | events.JoyBallMotion
    | events.Finger
)
_EventCallback: TypeAlias = Callable[[Any, _Event], object]
_EventCondition: TypeAlias = Callable[[Widget, _Event, Any], bool]

class Widget:
    """Base class for pdwidgets UI elements and simple container layouts."""

    next_instance_id: int
    id: int
    fg: int
    bg: int
    padding: tuple[int, int, int, int]
    radius: int
    children: list[Widget]
    dirty_widgets: set[Widget]
    dirty_descendants: set[Widget]
    invalidated: bool
    clip_content: bool
    def __init__(
        self,
        parent: Widget | None,
        x: _Length = 0,
        y: _Length = 0,
        w: _Length | None = None,
        h: _Length | None = None,
        align: int | None = None,
        align_to: Widget | None = None,
        fg: int | None = None,
        bg: int | None = None,
        visible: bool = True,
        value: Any = None,
        padding: tuple[int, int, int, int] | None = None,
        radius: int = 0,
    ) -> None: ...
    def __format__(self, format_spec: str) -> str: ...
    def add_event_cb(self, event_type: int, callback: _EventCallback, data: Any = None) -> None: ...
    def remove_event_cb(self, event_type: int, callback: _EventCallback) -> None: ...
    def handle_event(
        self, event: _Event, condition: _EventCondition | None = None, point: Any = None
    ) -> None: ...
    @property
    def parent(self) -> Widget | None: ...
    @parent.setter
    def parent(self, parent: Widget | None) -> None: ...
    @property
    def area(self) -> Area: ...
    @property
    def padded_area(self) -> Area: ...
    @property
    def x(self) -> int: ...
    @x.setter
    def x(self, x: _Length) -> None: ...
    @property
    def y(self) -> int: ...
    @y.setter
    def y(self, y: _Length) -> None: ...
    @property
    def width(self) -> int: ...
    @width.setter
    def width(self, w: _Length) -> None: ...
    @property
    def height(self) -> int: ...
    @height.setter
    def height(self, h: _Length) -> None: ...
    @property
    def align(self) -> int: ...
    @align.setter
    def align(self, align: int) -> None: ...
    @property
    def align_to(self) -> Widget | None: ...
    @align_to.setter
    def align_to(self, align_to: Widget) -> None: ...
    @property
    def display(self) -> Display: ...
    @property
    def color_theme(self) -> ColorTheme: ...
    @property
    def visible(self) -> bool: ...
    @visible.setter
    def visible(self, visible: bool) -> None: ...
    @property
    def value(self) -> Any: ...
    @value.setter
    def value(self, value: Any) -> None: ...
    def add_child(self, child: Widget) -> None: ...
    def changed(self) -> None: ...
    def draw(self, area: Area | None = None) -> None: ...
    def hide(self, hide: bool = True) -> None: ...
    def invalidate(self) -> None: ...
    def remove(self) -> None: ...
    def clear(self) -> None: ...
    def remove_child(self, widget: Widget) -> None: ...
    def set_change_cb(self, callback: Callable[[Any], object] | None) -> None: ...
    def set_position(
        self,
        x: _Length | None = None,
        y: _Length | None = None,
        w: _Length | None = None,
        h: _Length | None = None,
        align: int | None = None,
        align_to: Widget | None = None,
    ) -> None: ...
    def add_dirty_widget(self, child: Widget) -> None: ...
    def add_dirty_descendant(self, branch: Widget) -> None: ...
    def render(self) -> None: ...
    def remove_dirty_widget(self, child: Widget) -> None: ...
    def remove_dirty_descendant(self, branch: Widget) -> None: ...
    def set_value(self, value: Any) -> None: ...
    def set_modal(self, modal: bool = True) -> None: ...
