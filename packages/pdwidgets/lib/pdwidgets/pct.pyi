"""Classes that dynamically calculate a percentage of a widget's width or height."""

from typing import Any, TypeAlias

from .widget import Widget

_Length: TypeAlias = int | float | _Percent

class _Percent:
    """Cached percentage of a widget dimension."""

    __hash__: None  # type: ignore[assignment]
    def __init__(self, percent: int | float, widget: Widget) -> None: ...
    def __float__(self) -> float: ...
    def __eq__(self, other: object) -> bool: ...
    def __repr__(self) -> str: ...
    def __add__(self, other: Any) -> float: ...
    def __sub__(self, other: Any) -> float: ...
    def __mul__(self, other: Any) -> float: ...
    def __truediv__(self, other: Any) -> float: ...
    def __radd__(self, other: Any) -> float: ...
    def __rsub__(self, other: Any) -> float: ...
    def __rmul__(self, other: Any) -> float: ...
    def __rtruediv__(self, other: Any) -> float: ...
    def __int__(self) -> int: ...

class Height(_Percent):
    """Tracks a percentage of a widget's height."""

class Width(_Percent):
    """Tracks a percentage of a widget's width."""
